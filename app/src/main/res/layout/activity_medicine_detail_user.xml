<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/ivUserMedImage"
            android:layout_width="match_parent"
            android:layout_height="250dp"
            android:scaleType="centerCrop"
            android:src="@drawable/logo"
            android:layout_marginBottom="24dp"
            android:background="?attr/colorSurfaceVariant" />

        <TextView
            android:id="@+id/tvUserMedName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Medicine Name"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurface"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvUserMedCompound"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Compound Name"
            android:textSize="18sp"
            android:alpha="0.8"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/tvUserMedPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0.000 OMR"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="?attr/colorPrimary"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Description"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvUserMedDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Description goes here..."
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Usage Instructions"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvUserMedInstructions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Instructions go here..."
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Safety Info"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvUserMedSafety"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Warnings and age limits..."
            android:layout_marginBottom="32dp" />

        <Button
            android:id="@+id/btnPlaceOrder"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Place Order"
            style="@style/Widget.Material3.Button"
            android:layout_marginBottom="16dp" />

    </LinearLayout>
</ScrollView>
